	volume = {36},
	issn = {0758-1882},
	abstract = {The Cavalier King Charles Spaniel has a long silky coat, long drooping ears with flowing fringes. This animal has a predisposition to several common dermatoses and in particular to atopic dermatitis, demodicosis, and erythematous ceruminous otitis externa. Cutaneous disorders in this breed often appear in the form of an erythema associated with a marked state of seborrhoeic keratosis aggravated by frequent complications of Malassezia pyodermatitis and dermatitis. A description is also provided of rarer forms of dermatoses to which the Cavalier King Charles has a predisposition, such as primary keratinisation disorders and in particular a very rare congenital ichthyosis. Also to be noted in this breed is the frequency with which eosinophilic granulomas appear as well as a neuropathy manifested by a Syringohydromyelia pruritus.},
	language = {French},
	number = {3},
	journal = {PRATIQUE MEDICALE ET CHIRURGICALE DE L ANIMAL DE COMPAGNIE},
	author = {Florant, E},
	month = may,
	year = {2001},

	keywords = {dog, English cocker spaniel, GENE, aggression, behavior, BREED, CANINE AGGRESSION, CEREBROSPINAL-FLUID MONOAMINE, COLOR ALLELE, EXPRESSION, impulsiveness, PERSONALITY, PET DOGS, POLYMORPHISMS, UNITED-STATES},
	pages = {111--117},

@article{zurita_congenital_2019,
	title = {Congenital bilateral laryngeal paralysis in a 10-month-old {English} springer spaniel},
	volume = {7},
	issn = {2052-6121},
	doi = {10.1136/vetreccr-2018-000746},
	abstract = {This report describes a 10-month-old female, English springer spaniel that was referred to the surgical department for investigation of progressive exercise intolerance and stridor. After performing a complete blood test, thorough examination of the airway under a light plane of anaesthesia and CT of the head and thorax under general anaesthesia, bilateral laryngeal paralysis was diagnosed. Due to the dog's age and the absence of other aetiologies and neurological abnormalities, a diagnosis of congenital laryngeal paralysis was reached. Unilateral arytenoid lateralisation was performed with cricoarytenoid and thyroarytenoid sutures. The dog had an uneventful recovery and was successfully discharged the day following surgery with no recurrent respiratory signs for six months postoperatively (at the time this case report was written). This is the first case report that describes congenital bilateral laryngeal paralysis in an English springer spaniel.},
	language = {English},
	number = {2},
	journal = {VETERINARY RECORD CASE REPORTS},
	author = {Zurita, M and Dempsey, L},
	month = apr,
	year = {2019},
	keywords = {DOGS, congenital, english springer spaniel, laryngeal paralysis, POLYNEUROPATHY COMPLEX, Stridor, UNILATERAL ARYTENOID LATERALIZATION},
	annote = {Times Cited in Web of Science Core Collection:  0Total Times Cited:  0Cited Reference Count:  13},
}

